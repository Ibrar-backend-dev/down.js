# Production reference config. Copy to .env on your production host (or set
# these as real environment variables in your platform's dashboard, e.g.
# Railway's Variables tab) and fill in the real secrets - never commit real
# credentials. See .env.example for what each variable does in detail.

# --- Core ---

# Most PaaS hosts (Railway, Render, Heroku, ...) inject PORT themselves and
# expect the app to bind to it - do NOT set this yourself on those platforms,
# leave it unset so `process.env.PORT || 5000` picks up their injected value.
# Only set it explicitly on a host where YOU control the listening port
# (a VPS, a Docker container with a fixed port mapping, etc).
# PORT=5000

NODE_ENV=production

# Local disk is a poor fit for production: on most PaaS hosts (Railway,
# Render, Heroku, ...) the filesystem is EPHEMERAL - it's wiped on every
# redeploy, restart, or scale event, silently losing every downloaded file.
# Only rely on DOWNLOADS_DIR in production if you're on a host with a real
# persistent volume mounted at this path. Otherwise, configure B2 below and
# leave this as the (unused) fallback path.
DOWNLOADS_DIR=./downloads

# Set this to your actual frontend/consumer origin(s) in production - never
# leave it as '*' once real traffic is involved. Comma-separated if you need
# more than one origin (e.g. "https://app.example.com,https://admin.example.com").
SOCKET_CORS_ORIGIN=https://your-frontend.example.com

# --- Backblaze B2 storage (strongly recommended in production) ---
# All four required together to enable B2; omit all four to fall back to
# DOWNLOADS_DIR instead (not recommended in production - see above).
# Generate a scoped Application Key for this app specifically (B2 dashboard
# > Account > App Keys > Add a New Application Key), rather than reusing your
# master key - restrict it to just this bucket if you can.
B2_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key_secret
B2_BUCKET=your-bucket-name
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
B2_REGION=us-west-002
