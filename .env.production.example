# Production reference config. Copy to .env on your production host (or set
# these as real environment variables in your platform's dashboard) and fill
# in the real secrets - never commit real credentials.

# Leave PORT unset on most PaaS hosts (Railway, Render, Heroku) - they inject
# it themselves. Only set it on a host where you control the listening port.
# PORT=5000

NODE_ENV=production

# Local disk is ephemeral on most PaaS hosts - configure B2 below instead of
# relying on DOWNLOADS_DIR in production.
DOWNLOADS_DIR=./downloads

# Backblaze B2 storage (strongly recommended in production) - all four
# required together. Use a scoped Application Key, not your master key.
B2_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key_secret
B2_BUCKET=your-bucket-name
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
B2_REGION=us-west-002
