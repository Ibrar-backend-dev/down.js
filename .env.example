# Copy this file to .env and adjust as needed. .env is gitignored.

PORT=5000
NODE_ENV=development
DOWNLOADS_DIR=./downloads

# Optional: override how long a finished download stays fetchable before
# being auto-deleted (default 45000ms).
# AUTO_CLEANUP_DELAY_MS=45000

# Optional (B2 only): how often the background sweep checks the bucket for
# leftover files a restart/crash kept from being deleted (default 60000ms).
# CLEANUP_SWEEP_INTERVAL_MS=60000

# Backblaze B2 storage (optional) - set all four to store files in a B2
# bucket instead of DOWNLOADS_DIR. Leave unset to use local disk.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=us-west-002
