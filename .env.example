# Copy this file to .env and adjust as needed. .env is gitignored.

# Port the API server listens on.
PORT=5000

# development | production - affects morgan/error logging verbosity.
NODE_ENV=development

# Where downloaded files are written/read/deleted when B2 storage (below)
# is NOT configured - this is the fallback local storage location. Accepts
# an absolute path or one relative to the working directory the server is
# started from. Defaults to ./downloads at the project root if unset.
DOWNLOADS_DIR=./downloads

# CORS origin allowed to connect to the Socket.IO download-progress channel.
# Use a specific origin (e.g. https://your-frontend.example.com) in
# production; defaults to '*' (any origin) if unset.
SOCKET_CORS_ORIGIN=*

# --- Backblaze B2 storage (optional) ---
# Set all four of these to store downloaded files in a B2 bucket (via its
# S3-compatible API) instead of the local DOWNLOADS_DIR above. B2 becomes
# the ONLY place finished files live in that case - yt-dlp still downloads
# to local disk first (it has no B2-aware output mode), but the file is
# uploaded and the local copy removed as soon as the download completes.
# Leave any of these unset/empty to keep using local disk storage.
#
# B2_KEY_ID / B2_APPLICATION_KEY: an Application Key from the B2 dashboard
# (Account > App Keys). B2_BUCKET is the bucket name. B2_ENDPOINT is the
# bucket's S3-compatible endpoint, e.g. https://s3.us-west-002.backblazeb2.com
# (shown on the bucket's details page). B2_REGION defaults to us-west-002
# if unset - set it to match your bucket's actual region if different.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=us-west-002
