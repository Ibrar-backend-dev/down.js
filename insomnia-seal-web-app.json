    {
      "_id": "fld_direct_link",
      "parentId": "wrk_seal_web_app",
      "modified": 1780000000000,
      "created": 1780000000000,
      "name": "Direct link (strict progressive MP4)",
      "description": "GET /api/download/link. Returns JSON only when yt-dlp exposes one direct HTTPS progressive MP4 (video+audio, no manifest/DASH/HLS/merge). Supported platforms: TikTok, Instagram, Facebook, X/Twitter, LinkedIn. Unsupported hosts return 422 UNSUPPORTED_DIRECT_LINK_PLATFORM; supported posts with no qualifying format return 422 DIRECT_LINK_UNAVAILABLE. For TikTok, the response also includes a `requestHeaders` object (Cookie + Referer) captured from the anonymous session that resolved the URL - TikTok's CDN returns 403 for the bare URL without them, so send them with the download request. LinkedIn's CDN needs no special headers at all.",
      "environment": {},
      "environmentPropertyOrder": null,
      "metaSortKey": -0.5,
      "_type": "request_group"
    },
